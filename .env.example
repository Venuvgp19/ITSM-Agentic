# ==========================================
# Enterprise ITSM Platform Environment Config
# ==========================================

# Database Connection (PostgreSQL 15+)
DATABASE_URL="postgresql://itsm_user:itsm_password@localhost:5432/itsm_db?schema=public"

# Redis Cache & Queue
REDIS_HOST="localhost"
REDIS_PORT=6379

# RabbitMQ Event Bus
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# MinIO / S3 Storage
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="itsm-attachments"

# JWT Authentication Secrets
JWT_SECRET="super-secret-jwt-key-change-in-production-mode-32bytes"
JWT_EXPIRATION="8h"
REFRESH_TOKEN_SECRET="refresh-secret-jwt-key-enterprise-itsm"
REFRESH_TOKEN_EXPIRATION="7d"

# LLM API Keys (NVIDIA Nim & OpenAI)
NVIDIA_API_KEY="nvapi-your-nvidia-api-key-here"
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Application Service Ports
PORT=4000
FRONTEND_PORT=3000
DASHBOARD_PORT=5173
GENAI_API_KEY=sk-your-genai-key-here
ITSM_BASE_URL=http://localhost:4000/api/v1
GENAI_LAB_URL=https://genailab.tcs.in/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
