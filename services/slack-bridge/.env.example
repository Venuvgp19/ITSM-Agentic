# Slack App credentials (from api.slack.com/apps -> your app)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Channel where approval cards get posted (channel ID, e.g. C0123456789 -
# invite the bot to this channel first: /invite @YourBotName)
SLACK_APPROVALS_CHANNEL=

# Agent Control Tower base URL (the live dashboard backend, port 5173)
CONTROL_TOWER_URL=http://localhost:5173

# How often to poll for new pending approvals (ms)
POLL_INTERVAL_MS=15000
